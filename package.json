{
  "name": "palworld-font-customizer",
  "version": "0.1.0",
  "private": true,
  "description": "Palworld global single-font replacement tool",
  "author": "FlandreScarletV",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/renderer/app.js && node --check src/renderer/font-library.js",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "dev.flandrescarlet.palworldfontcustomizer",
    "productName": "Palworld Font Customizer",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "portable",
      "artifactName": "Palworld-Font-Customizer-${version}.${ext}"
    }
  }
}